#!/usr/bin/env bash
#
# Reject a commit that stages a file too big to hold in context at once.
#
# Size is estimated as bytes / 4 tokens and measured on the staged blob -- the
# content actually going into the commit, not the working tree. Files nobody
# hand-writes (lockfiles, vendored trees, codegen output, binaries) are skipped.
#
# Tune the two numbers below if the limit changes.
# Bypass for one commit with `git commit --no-verify`.

set -uo pipefail

max_tokens=5000
bytes_per_token=4
max_bytes=$((max_tokens * bytes_per_token))

cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

# Never worth splitting: generated, vendored or machine-maintained.
# Globs match the whole path; add project-specific entries here.
skip_globs=(
  # Lockfiles
  '*.lock'
  'Cargo.lock'
  'package-lock.json'
  'npm-shrinkwrap.json'
  'yarn.lock'
  'pnpm-lock.yaml'
  'bun.lockb'
  'go.sum'
  'Gemfile.lock'
  'poetry.lock'
  'Pipfile.lock'
  'uv.lock'
  'composer.lock'
  'pubspec.lock'
  'flake.lock'
  'mix.lock'
  # Vendored dependencies and build output
  'node_modules/*'
  '*/node_modules/*'
  'vendor/*'
  '*/vendor/*'
  'target/*'
  '*/target/*'
  'third_party/*'
  '*/third_party/*'
  'dist/*'
  '*/dist/*'
  # Generated or emitted files
  '*.min.js'
  '*.min.css'
  '*.map'
  '*.snap'
  '*.pb.go'
  '*.pb.rs'
  '*_pb2.py'
  '*.g.dart'
  '*.freezed.dart'
  '*.generated.*'
  '*_generated.*'
  'generated/*'
  '*/generated/*'
)

skipped() {
  local path=$1 glob
  for glob in "${skip_globs[@]}"; do
    [[ $path == $glob ]] && return 0
  done
  return 1
}

rows=''
while IFS= read -r -d '' path; do
  skipped "$path" && continue
  # Submodule pointers are commits, not files.
  [[ $(git cat-file -t ":$path" 2>/dev/null) == blob ]] || continue
  # git reports a binary blob with "-" instead of added/removed line counts.
  if git diff --cached --numstat -- "$path" 2>/dev/null | cut -f1 | grep -qx -- '-'; then
    continue
  fi

  bytes=$(git cat-file -s ":$path" 2>/dev/null) || continue
  [ "$bytes" -gt "$max_bytes" ] || continue

  tokens=$(((bytes + bytes_per_token - 1) / bytes_per_token))
  rows+="$tokens $bytes $path"$'\n'
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ -n "$rows" ] || exit 0
count=$(printf '%s' "$rows" | grep -c .)

{
  echo
  echo "✗ pre-commit: $count staged file(s) exceed $max_tokens tokens ($max_bytes bytes, 1 token ≈ 4 bytes)"
  echo
  printf '%s' "$rows" | sort -k1,1rn | while read -r tokens bytes path; do
    printf '    %6s tokens  %8s bytes  %s\n' "$tokens" "$bytes" "$path"
  done
  cat <<'EOF'

  Sizes come from the staged blobs, so the fix is to split the files above and
  stage the result. Big files are hard to review, hard to hold in context, and
  merge badly, so this hook refuses them rather than warning.

  How to split one:

    1. List its jobs. Read the file and name each responsibility: state,
       input handling, layout, painting, persistence, helpers. One sentence
       per job is enough.
    2. Pick the job with the cleanest boundary -- fewest references to the
       rest -- and give it a module. Next to the original, e.g. for
       src/app.rs use src/app/selection.rs; for a flat module, src/selection.rs.
    3. Move, do not copy. `git mv src/app.rs src/app/mod.rs` when most of the
       file belongs in one place, or create the new module and cut one block
       at a time so history follows the code.
    4. Keep the old paths working. Re-export what callers already import
       (`pub use selection::*;` in src/app/mod.rs) so the split needs no
       changes elsewhere, then narrow the surface later if you want.
    5. Build and test after every move (`cargo test`). One green step per
       block beats one large rewrite.
    6. Repeat until each file is under the limit, then `git add -u` plus the
       new modules. The hook only checks staged content, so re-staging is part
       of the fix.

  Splitting a test file works the same way: group tests by the behaviour they
  cover and move each group behind a shared helper module.

  For a mechanical commit that cannot be split (a pure rename, say), bypass
  once with `git commit --no-verify` and split immediately after.

  Limit: 5,000 tokens per file, counted as bytes / 4.
EOF
} >&2

exit 1
