#!/usr/bin/env bash
#
# Reject a commit that stages a file too big to hold in context at once.
#
# Size is estimated as bytes / 4 tokens and measured on the staged blob -- the
# content actually going into the commit, not the working tree. Files nobody
# hand-writes (lockfiles, vendored trees, codegen output, binaries) are skipped
# by the globs below.
#
# The remedy for each case, and the split procedure itself, live in
# docs/splitting-files.md. Tune max_tokens if the limit changes.

set -uo pipefail

max_tokens=5000
bytes_per_token=4
max_bytes=$((max_tokens * bytes_per_token))

cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

# Never worth splitting: generated, vendored or machine-maintained.
# Globs match the whole path; add project-specific entries here.
skip_globs=(
  # Lockfiles
  '*.lock'
  'Cargo.lock'
  'package-lock.json'
  'npm-shrinkwrap.json'
  'yarn.lock'
  'pnpm-lock.yaml'
  'bun.lockb'
  'go.sum'
  'Gemfile.lock'
  'poetry.lock'
  'Pipfile.lock'
  'uv.lock'
  'composer.lock'
  'pubspec.lock'
  'flake.lock'
  'mix.lock'
  # Vendored dependencies and build output
  'node_modules/*'
  '*/node_modules/*'
  'vendor/*'
  '*/vendor/*'
  'target/*'
  '*/target/*'
  'third_party/*'
  '*/third_party/*'
  'dist/*'
  '*/dist/*'
  # Generated or emitted files
  '*.min.js'
  '*.min.css'
  '*.map'
  '*.snap'
  '*.pb.go'
  '*.pb.rs'
  '*_pb2.py'
  '*.g.dart'
  '*.freezed.dart'
  '*.generated.*'
  '*_generated.*'
  'generated/*'
  '*/generated/*'
)

skipped() {
  local path=$1 glob
  for glob in "${skip_globs[@]}"; do
    [[ $path == $glob ]] && return 0
  done
  return 1
}

rows=''
while IFS= read -r -d '' path; do
  skipped "$path" && continue
  # Submodule pointers are commits, not files.
  [[ $(git cat-file -t ":$path" 2>/dev/null) == blob ]] || continue
  # git reports a binary blob with "-" instead of added/removed line counts.
  if git diff --cached --numstat -- "$path" 2>/dev/null | cut -f1 | grep -qx -- '-'; then
    continue
  fi

  bytes=$(git cat-file -s ":$path" 2>/dev/null) || continue
  [ "$bytes" -gt "$max_bytes" ] || continue

  tokens=$(((bytes + bytes_per_token - 1) / bytes_per_token))
  rows+="$tokens $bytes $path"$'\n'
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ -n "$rows" ] || exit 0
count=$(printf '%s' "$rows" | grep -c .)

{
  echo
  echo "✗ pre-commit: $count staged file(s) exceed $max_tokens tokens ($max_bytes bytes, 1 token ≈ $bytes_per_token bytes)"
  echo
  printf '%s' "$rows" | sort -k1,1rn | while read -r tokens bytes path; do
    printf '    %6s tokens  %8s bytes  %s\n' "$tokens" "$bytes" "$path"
  done
  cat <<EOF

  Sizes come from the staged blobs, so staging the split result is part of the
  fix. Fix each file one of three ways:

    Split it      Hand-written source, tests, or a page with behaviour: follow
                  docs/splitting-files.md. Big files are hard to review, hard
                  to hold in context, and merge badly.
    Skip it       Generated, vendored, or a fixture nobody hand-writes: add a
                  narrow glob to skip_globs above, e.g. 'tests/fixtures/*.json'.
    Bypass once   A mechanical commit that cannot be split: git commit
                  --no-verify, then split it in the next commit.

  Done means every file above is under $max_tokens tokens and staged, with
  cargo check and the touched crates' tests green.
EOF
} >&2

exit 1
