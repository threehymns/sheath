#!/usr/bin/env python3
"""Compare two screenshots pixel by pixel, for hill-climbing the boot shell to the app's render.

    scripts/shell-diff REFERENCE.png CANDIDATE.png [--diff OUT.png] [--region X,Y,W,H]
                      [--tolerance N] [--quiet]

Prints the number of differing pixels, the largest per-channel delta, the bounding box of the
differences and the worst pixels, and exits 1 when anything differs by more than `--tolerance`.
`--diff` writes a PNG with each differing pixel in magenta (unchanged pixels dimmed), which makes
a 1-pixel offset obvious. `--region` compares only that rectangle, so text antialiasing can be
excluded while geometry is matched.

Pure Python on purpose: no Pillow, no ImageMagick, nothing to install. Handles the 8-bit RGB and
RGBA, non-interlaced PNGs that Chrome and the OS screenshots produce.
"""

import struct
import sys
import zlib
from pathlib import Path


def decode_png(path: Path) -> tuple[int, int, int, bytes]:
    data = path.read_bytes()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise SystemExit(f"{path}: not a PNG")
    pos, idat = 8, bytearray()
    width = height = depth = color = interlace = 0
    while pos < len(data):
        (length,) = struct.unpack(">I", data[pos : pos + 4])
        kind = data[pos + 4 : pos + 8]
        chunk = data[pos + 8 : pos + 8 + length]
        pos += 12 + length
        if kind == b"IHDR":
            width, height, depth, color, _, _, interlace = struct.unpack(">IIBBBBB", chunk)
        elif kind == b"IDAT":
            idat += chunk
        elif kind == b"IEND":
            break
    if depth != 8 or interlace != 0 or color not in (2, 6):
        raise SystemExit(f"{path}: need an 8-bit, non-interlaced RGB/RGBA PNG")
    channels = 3 if color == 2 else 4
    raw = zlib.decompress(bytes(idat))
    stride = width * channels
    if len(raw) != (stride + 1) * height:
        raise SystemExit(f"{path}: truncated image data")

    pixels = bytearray(stride * height)
    previous = bytearray(stride)
    at = 0
    for row in range(height):
        filter_kind = raw[at]
        at += 1
        line = bytearray(raw[at : at + stride])
        at += stride
        if filter_kind == 1:  # Sub
            for i in range(channels, stride):
                line[i] = (line[i] + line[i - channels]) & 0xFF
        elif filter_kind == 2:  # Up
            for i in range(stride):
                line[i] = (line[i] + previous[i]) & 0xFF
        elif filter_kind == 3:  # Average
            for i in range(stride):
                left = line[i - channels] if i >= channels else 0
                line[i] = (line[i] + ((left + previous[i]) >> 1)) & 0xFF
        elif filter_kind == 4:  # Paeth
            for i in range(stride):
                a = line[i - channels] if i >= channels else 0
                b = previous[i]
                c = previous[i - channels] if i >= channels else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                predictor = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
                line[i] = (line[i] + predictor) & 0xFF
        elif filter_kind != 0:
            raise SystemExit(f"{path}: unknown PNG filter {filter_kind}")
        pixels[row * stride : (row + 1) * stride] = line
        previous = line
    return width, height, channels, bytes(pixels)


def encode_png(path: Path, width: int, height: int, rgb: bytearray) -> None:
    stride = width * 3
    raw = bytearray()
    for row in range(height):
        raw.append(0)
        raw += rgb[row * stride : (row + 1) * stride]

    def chunk(kind: bytes, body: bytes) -> bytes:
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xFFFFFFFF)

    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    path.write_bytes(
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", zlib.compress(bytes(raw), 9))
        + chunk(b"IEND", b"")
    )


def parse_args(argv: list[str]) -> tuple[Path, Path, Path | None, tuple[int, int, int, int] | None, int, bool]:
    positional: list[Path] = []
    diff = None
    region = None
    tolerance = 0
    quiet = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--diff", "--region", "--tolerance"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{arg} needs a value")
            value = argv[i + 1]
            i += 2
            if arg == "--diff":
                diff = Path(value)
            elif arg == "--region":
                try:
                    x, y, w, h = (int(part) for part in value.split(","))
                except ValueError:
                    raise SystemExit("--region is X,Y,W,H")
                region = (x, y, w, h)
            else:
                tolerance = int(value)
        elif arg == "--quiet":
            quiet = True
            i += 1
        elif arg in ("-h", "--help"):
            print(__doc__)
            raise SystemExit(0)
        else:
            positional.append(Path(arg))
            i += 1
    if len(positional) != 2:
        raise SystemExit("usage: shell-diff REFERENCE.png CANDIDATE.png [--diff OUT.png] [--region X,Y,W,H] [--tolerance N]")
    return positional[0], positional[1], diff, region, tolerance, quiet


def main() -> int:
    reference_path, candidate_path, diff_path, region, tolerance, quiet = parse_args(sys.argv[1:])
    rw, rh, rc, rp = decode_png(reference_path)
    cw, ch, cc, cp = decode_png(candidate_path)
    if (rw, rh, rc) != (cw, ch, cc):
        print(f"size mismatch: {reference_path} is {rw}x{rh}/{rc}ch, {candidate_path} is {cw}x{ch}/{cc}ch")
        return 1
    if region is None:
        region = (0, 0, rw, rh)
    x0, y0, width, height = region
    if x0 < 0 or y0 < 0 or x0 + width > rw or y0 + height > rh:
        raise SystemExit(f"--region {x0},{y0},{width},{height} does not fit {rw}x{rh}")

    differing = 0
    total = width * height
    worst_delta = 0
    delta_sum = 0
    min_x = min_y = 1 << 30
    max_x = max_y = -1
    worst: list[tuple[int, int, int]] = []
    diff_pixels = bytearray(width * height * 3) if diff_path else None

    for y in range(y0, y0 + height):
        row = ((y - y0) * width)
        for x in range(x0, x0 + width):
            at = (y * rw + x) * rc
            pixel_delta = 0
            for channel in range(3):
                pixel_delta = max(pixel_delta, abs(rp[at + channel] - cp[at + channel]))
            if diff_pixels is not None:
                base = (row + (x - x0)) * 3
                shade = (cp[at] + cp[at + 1] + cp[at + 2]) // 12
                diff_pixels[base : base + 3] = bytes((shade, shade, shade))
            if pixel_delta == 0:
                continue
            delta_sum += pixel_delta
            if pixel_delta > worst_delta:
                worst_delta = pixel_delta
            if pixel_delta > tolerance:
                differing += 1
                min_x, min_y = min(min_x, x), min(min_y, y)
                max_x, max_y = max(max_x, x), max(max_y, y)
                if diff_pixels is not None:
                    base = (row + (x - x0)) * 3
                    diff_pixels[base : base + 3] = bytes((255, 0, 255))
                worst.append((pixel_delta, x, y))
                if len(worst) > 64:
                    worst.sort(reverse=True)
                    del worst[16:]

    if diff_pixels is not None:
        diff_path.parent.mkdir(parents=True, exist_ok=True)
        encode_png(diff_path, width, height, diff_pixels)

    if not quiet:
        share = 100.0 * differing / total if total else 0.0
        mean = delta_sum / differing if differing else 0.0
        print(f"region {x0},{y0} {width}x{height} of {rw}x{rh}")
        print(f"differing {differing} px ({share:.3f}%), max delta {worst_delta}, mean delta {mean:.2f}, tolerance {tolerance}")
        if differing:
            print(f"bbox x {min_x}..{max_x}, y {min_y}..{max_y}")
            worst.sort(reverse=True)
            for pixel_delta, x, y in worst[:5]:
                print(f"  worst ({x},{y}) delta {pixel_delta}")
        if diff_path:
            print(f"wrote {diff_path}")
    return 1 if differing else 0


if __name__ == "__main__":
    sys.exit(main())
