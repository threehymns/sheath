#!/usr/bin/env bash
# Run Rune's hot-reload launcher from the Rune checkout Cargo already fetched.
#
# The app declares `hot = ["rune/hot"]`; edits to function bodies in --patch files
# patch into the running window. See "Live editing" in README.md.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

rune_manifest=$(cargo metadata --format-version 1 |
  python3 -c 'import json,sys; print(next(p["manifest_path"] for p in json.load(sys.stdin)["packages"] if p["name"] == "rune" and "anomalyco/rune" in (p.get("source") or "")))')

launcher=$(dirname "$rune_manifest")/../../scripts/rune-hot
if [[ ! -f $launcher ]]; then
  echo "dev: $launcher is missing; check the Rune revision in Cargo.toml" >&2
  exit 1
fi

# dx caches the fat-link archive by existence alone, so an interrupted build leaves a
# 0-byte libdeps-*.a that it reuses on every later run; mold then rejects it as an
# "unknown file type". Drop those so dx regenerates them instead of failing the link.
rune_root=$(cd "$(dirname "$rune_manifest")/../.." && pwd)
while IFS= read -r -d '' stale; do
  echo "dev: removing truncated $(basename "$stale"); dx will regenerate it" >&2
  rm -f "$stale"
done < <(find "$rune_root/target/live-edit-build" -type f -name 'libdeps-*.a' -empty -print0 2>/dev/null)

exec bash "$launcher" --manifest Cargo.toml "$@"
